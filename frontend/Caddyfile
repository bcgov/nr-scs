# Listen only on high ports (3000, 3001, 3003).
{
	metrics
	auto_https off
	admin 0.0.0.0:3003
	order coraza_waf first
}
:3000 {
	log {
		output stdout
		format console
		level {$LOG_LEVEL}
	}

	# Enable Coraza WAF
	coraza_waf {
		directives `
		Include /etc/caddy/coraza.conf
		`
	}

	root * /srv
	encode zstd gzip
	file_server
	@spa_router {
		not path /api*
		file {
			try_files {path} /index.html
		}
	}
	rewrite @spa_router {http.matchers.file.relative}
	# Proxy requests to API service
	reverse_proxy /api* {$BACKEND_URL} {
		header_up Host {http.reverse_proxy.upstream.hostport}
		header_up X-Real-IP {remote_host}
	}
	header {
		-Server
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1;mode=block"
		Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		# The policy the WAR served (backend csp.policy), with Cognito swapped for BC Gov SSO:
		# oidc-client-ts fetches the realm's discovery document, JWKS and token endpoint from
		# *.loginproxy.gov.bc.ca. Sign-in and sign-out are top-level navigations, which CSP does not
		# restrict. img-src blob: is for report previews.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://loginproxy.gov.bc.ca https://*.loginproxy.gov.bc.ca; frame-ancestors 'none'; form-action 'self'; object-src 'none'; base-uri 'self';"
		Referrer-Policy "same-origin"
		Permissions-Policy "fullscreen=(self), camera=(), microphone=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		# credentialless clears ZAP 90004. require-corp would block no-cors
		# cross-origin assets still allowed by the CSP (fonts, map tiles).
		Cross-Origin-Embedder-Policy "credentialless"
	}
}
:3001 {
	handle /health {
		respond "OK"
	}
}
