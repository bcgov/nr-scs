{
  "name": "nr-hrs-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "generate-amplify-config": "node scripts/generate-amplify-config.cjs",
    "prestart": "npm run generate-amplify-config",
    "prebuild": "npm run generate-amplify-config",
    "start": "vite",
    "build": "cross-env CI=false vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --config vitest.config.ts",
    "test:unit": "vitest --config vitest.config.ts",
    "pretest:browser": "playwright install",
    "test:browser": "vitest --config vitest.browser.config.ts",
    "test:coverage": "node scripts/run-coverage.cjs",
    "test:ci": "node scripts/run-coverage.cjs",
    "test:watch": "vitest --config vitest.config.ts --coverage",
    "e2e:browsers": "playwright install chromium",
    "e2e:bddgen": "bddgen test --config e2e/playwright.config.ts",
    "e2e:prepare": "npm run e2e:browsers && npm run e2e:bddgen",
    "e2e:test": "playwright test --config e2e/playwright.config.ts",
    "pretest:e2e": "npm run e2e:prepare",
    "test:e2e": "npm run e2e:test -- --grep-invert @generation",
    "pretest:e2e:headed": "npm run e2e:prepare",
    "test:e2e:headed": "npm run e2e:test -- --grep-invert @generation --headed",
    "pretest:e2e:ui": "npm run e2e:prepare",
    "test:e2e:ui": "npm run e2e:test -- --grep-invert @generation --ui",
    "pretest:e2e:generation": "npm run e2e:prepare",
    "test:e2e:generation": "npm run e2e:test -- --grep @generation --workers=1",
    "test:e2e:all": "npm run e2e:prepare && npm run e2e:test -- --grep-invert @generation && npm run e2e:test -- --grep @generation --workers=1",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:codegen": "playwright codegen http://localhost:3000"
  },
  "dependencies": {
    "@bcgov-nr/nr-theme": "^1.8.9",
    "@carbon/charts": "^1.23.15",
    "@carbon/charts-react": "^1.23.15",
    "@carbon/icons-react": "^11.64.0",
    "@carbon/pictograms-react": "^11.83.0",
    "@carbon/react": "^1.104.1",
    "@tanstack/react-query": "^5.84.1",
    "aws-amplify": "^6.16.2",
    "axios": "^1.13.5",
    "dompurify": "^3.4.13",
    "idb": "^8.0.3",
    "luxon": "^3.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-plugin-query": "^5.83.1",
    "@tanstack/react-query-devtools": "^5.84.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/carbon__pictograms-react": "^11.46.15",
    "@types/dompurify": "^3.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/prettier": "^3.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/service-worker-mock": "^2.0.4",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "happy-dom": "^20.0.0",
    "lint-staged": "^17.0.0",
    "playwright": "^1.63.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.0.0"
  }
}
