# Standard exclusions
*.md
.git
.github
.idea
.vscode
Dockerfile
CODE_OF_CONDUCT*
CONTRIBUTING*
LICENSE*
SECURITY*

# Node exclusions
build
dist
node_modules

# Local-only runtime config and env files (the image's amplify-config.js is generated at start)
public/amplify-config.js
.env
.env.*
!.env.example

# App-specific exclusions (the E2E suite is not part of the image)
coverage
e2e
output
test-results
playwright-report
