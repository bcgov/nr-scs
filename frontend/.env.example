# Example environment variables for the SCS frontend.
# Copy into a gitignored .env.local and fill in real values.
# Real, environment-specific values are NOT committed.

# --- Local dev / mock auth -----------------------------------------------
# Set to "true" to bypass BC Gov SSO (Keycloak) entirely and use a mock user.
# Requires SECURITY_JWT_ENABLED=false and APP_ENVIRONMENT=LOCAL on the backend.
VITE_MOCK_USER=true

# App name shown in the browser tab title.
VITE_APP_NAME=SCS

# Deployment zone (dev | test | prod). A display label only.
VITE_ZONE=dev

# --- Real auth (BC Gov SSO, Keycloak standard realm) -----------------------
# Required when VITE_MOCK_USER=false. TWO values, and only two: oidc-client-ts discovers the
# authorize, token, JWKS and end-session endpoints from the issuer, so there is no logout URL.
# The backend reads the SAME two values as KEYCLOAK_ISSUER_URI / KEYCLOAK_CLIENT_ID; a mismatch
# shows up as 401s after a successful sign-in.
# The redirect URI is not configured: it is <origin>/authCallback, which must be registered on the
# CSS integration (e.g. http://localhost:3000/authCallback for local dev).
VITE_KEYCLOAK_URL=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
VITE_KEYCLOAK_CLIENT_ID=

# --- Optional features ---------------------------------------------------
# External "Client Application" link shown on the Scale Site -> Contacts tab.
# When unset, the button renders disabled.
# VITE_CLIENT_APPLICATION_URL=https://<client-application-host>/int/client/

# Enable offline / IndexedDB mode.
# VITE_FEATURES_OFFLINE=false
