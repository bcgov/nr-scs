# Example environment variables for the SCS frontend.
# Copy into a gitignored .env.local and fill in real values.
# Real, environment-specific values are NOT committed.

# --- Local dev / mock auth -----------------------------------------------
# Set to "true" to bypass FAM/Cognito entirely and use a mock clerical user.
# Requires security.jwt.enabled=false on the backend.
VITE_MOCK_USER=true

# App name shown in the browser tab title.
VITE_APP_NAME=SCS

# Deployment zone (dev | test | prod). Used by RealAuthProvider for env detection.
# Not required when VITE_MOCK_USER=true.
VITE_ZONE=dev

# --- Real auth (FAM / Cognito) -------------------------------------------
# Required when VITE_MOCK_USER=false.
VITE_USER_POOLS_ID=
VITE_USER_POOLS_WEB_CLIENT_ID=
# Override the sign-out redirect if the default IDIR logout URL is not suitable.
# VITE_REDIRECT_SIGN_OUT=

# --- Optional features ---------------------------------------------------
# External "Client Application" link shown on the Scale Site -> Contacts tab.
# When unset, the button renders disabled.
# VITE_CLIENT_APPLICATION_URL=https://<client-application-host>/int/client/

# Enable offline / IndexedDB mode.
# VITE_FEATURES_OFFLINE=false
