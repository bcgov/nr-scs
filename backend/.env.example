# ===========================================
# SCS Backend environment variables (local development)
# ===========================================
# Copy to .env (gitignored). docker compose reads it; for IDE runs, set these in the run config.
# Every key maps to backend/src/main/resources/application.yml.

SERVER_PORT=8080

# Local mock auth: no Cognito, a synthetic user whose roles come from the frontend's mock picker.
# Refused at startup unless APP_ENVIRONMENT is LOCAL or DEV.
SECURITY_JWT_ENABLED=false
APP_ENVIRONMENT=LOCAL

# Oracle. DATABASE_URL overrides the TCPS URL built from host/port/service name, e.g. the seeded
# Oracle container used by the E2E suite (see frontend/e2e/README.md).
DATABASE_URL=jdbc:oracle:thin:@//localhost:1525/DBDOCK_01
DATABASE_USER=
DATABASE_PASSWORD=
# Deployed (TCPS) form instead of DATABASE_URL:
# DATABASE_HOST=
# DATABASE_PORT=1543
# DATABASE_SERVICE_NAME=
# TRUSTSTORE_PATH=/absolute/path/to/jssecacerts
# KEYSTORE_SECRET=

# Real auth (FAM/Cognito) — until the Keycloak move.
# SECURITY_JWT_ENABLED=true
# JWT_ISSUER_JWKS_URI=https://cognito-idp.ca-central-1.amazonaws.com/<user-pool-id>/.well-known/jwks.json
# JWT_AUDIENCE=<cognito app client id>

# JasperReports Server
JASPER_SERVER_LOGIN_URL=
JASPER_SERVER_FETCH_URL=
JASPER_SERVER_USERNAME=
JASPER_SERVER_PASSWORD=

# CHES email (MAIL_ENABLED=true requires the URLs and credentials)
MAIL_ENABLED=false
CHES_EMAIL_URL=
CHES_TOKEN_URL=
CHES_CLIENT_ID=
CHES_CLIENT_SECRET=
CHES_FROM_EMAIL=

APP_LOG_LEVEL=DEBUG
