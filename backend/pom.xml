<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ca.bc.gov.nrs</groupId>
    <artifactId>scs-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>SCS Backend</name>
    <description>SCS Backend (Spring Boot, Oracle PL/SQL packages, JasperServer reports)</description>

    <url>https://github.com/bcgov/nr-scs</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/bcgov/nr-scs.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:bcgov/nr-scs.git</developerConnection>
        <url>https://github.com/bcgov/nr-scs</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <sonar.language>java</sonar.language>
        <sonar.organization>bcgov-sonarcloud</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>

        <springdoc.version>2.8.17</springdoc.version>
        <openapi-generator.version>7.25.0</openapi-generator.version>
        <swagger-ui.version>5.32.15</swagger-ui.version>
        <jacoco.version>0.8.16</jacoco.version>

        <!--
          Overrides of Boot-managed versions. Each keeps the version the WAR build (bcgov-c/nr-scs)
          already ran and tested with, so the move to Boot does not also downgrade a library.
          - mockito: capped at 5.22.0. 5.23.0's inline mock maker fails to instrument classes whose
            methods return generated model.* types (e.g. MarkSiteDesignationRepository), poisoning
            the surefire JVM and cascading into ~120 unrelated test errors. renovate.json holds the cap.
          - hibernate-validator 9 / jakarta-validation 3.1: Boot 3.5 manages 8.0 / 3.0.
          - junit-jupiter 6: Boot 3.5 manages 5.12.
        -->
        <mockito.version>5.22.0</mockito.version>
        <hibernate-validator.version>9.1.4.Final</hibernate-validator.version>
        <jakarta-validation.version>3.1.1</jakarta-validation.version>
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <h2.version>2.5.250</h2.version>
        <caffeine.version>3.3.0</caffeine.version>
        <lombok.version>1.18.48</lombok.version>
        <ojdbc.version>23.26.3.0.0</ojdbc.version>
        <!-- jackson 2.21.7+ fixes the jackson-core ReDoS and jackson-databind advisories (Boot manages 2.21.4). -->
        <jackson-bom.version>2.21.8</jackson-bom.version>

        <!-- Security fixes for legacy/transitive dependencies -->
        <commons-io.version>2.22.0</commons-io.version>
        <commons-fileupload.version>1.6.0</commons-fileupload.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-collections.version>3.2.2</commons-collections.version>

        <!--
          Duplication (CPD) is not measured on generated code: the OpenAPI-generated models and API
          interfaces are boilerplate (equals/hashCode/toString, fluent setters) that is duplicated by
          construction and cannot be refactored. Issues and coverage still follow their own rules.
        -->
        <sonar.cpd.exclusions>
            generated/**/*,
            **/generated-sources/**/*
        </sonar.cpd.exclusions>

        <sonar.coverage.exclusions>
            **/generated-sources/**/*,
            src/main/java/ca/bc/gov/nrs/scs/backend/ScsApiApplication.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/model/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/model/Report/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/repository/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/dto/*.java,
            generated/src/main/java/ca/bc/gov/nrs/scs/backend/model/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/exception/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/config/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/api/*.java,
            generated/src/main/java/ca/bc/gov/nrs/scs/backend/api/*.java,
            src/main/java/ca/bc/gov/nrs/scs/backend/model/repository/*.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <!-- Web: Undertow instead of Tomcat, matching the other NRIDS Spring Boot apps. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-undertow</artifactId>
        </dependency>
        <!--
          CVE-2026-3260 — Undertow DoS: a GET carrying multipart/form-data is parsed and spooled to disk
          as soon as the app reads parameters. Boot 3.5.16 manages 2.3.24.Final, which is affected.
          Pinned on undertow-core alone: the 2.4.x line publishes only the core module, so overriding
          Boot's `undertow.version` cannot resolve undertow-servlet. Drop once Boot manages a fixed release.
        -->
        <dependency>
            <groupId>io.undertow</groupId>
            <artifactId>undertow-core</artifactId>
            <version>2.4.4.Final</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>8.20.0</version>
        </dependency>
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>2.0.2</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>7.0.8</version>
            <exclusions>
                <exclusion>
                    <groupId>commons-collections</groupId>
                    <artifactId>commons-collections</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-beanutils</groupId>
                    <artifactId>commons-beanutils</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
                <!--
                  On the classpath, jackson-dataformat-xml makes Spring register the XML message
                  converter, which can flip REST content negotiation to XML. The API is JSON-only.
                -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.dataformat</groupId>
                    <artifactId>jackson-dataformat-xml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Security Overrides for Transitive Dependencies -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-fileupload</groupId>
            <artifactId>commons-fileupload</artifactId>
            <version>${commons-fileupload.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-beanutils</groupId>
            <artifactId>commons-beanutils</artifactId>
            <version>${commons-beanutils.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>${commons-collections.version}</version>
        </dependency>

        <!-- Database Drivers -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${ojdbc.version}</version>
        </dependency>

        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>swagger-ui</artifactId>
            <version>${swagger-ui.version}</version>
        </dependency>

        <!-- Dependencies for OpenAPI Generator -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.11</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!-- JJWT for JWT creation and validation -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- For handling JWKS URIs to fetch public keys -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>jwks-rsa</artifactId>
            <version>0.24.1</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>This project requires Java 21 or newer. Set JAVA_HOME to a JDK 21+ install.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <failIfNoTests>false</failIfNoTests>
                    <!-- Load Mockito's inline mock maker as an explicit Java agent. On JDK 21+ the
                         JVM no longer allows the agent to self-attach at runtime; without this the
                         forked test VM crashes while instrumenting a mock and poisons class loading,
                         cascading into dozens of unrelated "ClassNotFoundException" test errors.
                         @{argLine} preserves the JaCoCo agent argLine set by jacoco:prepare-agent. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>

            <!-- Exposes ${org.mockito:mockito-core:jar} (resolved local-repo path) for the
                 surefire -javaagent argument above. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-mockito-agent-path</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/generated/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- OpenAPI Generator: the spec under src/main/resources/openapi is the API contract. -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/openapi/root.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.basedir}/generated</output>
                            <apiPackage>ca.bc.gov.nrs.scs.backend.api</apiPackage>
                            <modelPackage>ca.bc.gov.nrs.scs.backend.model</modelPackage>
                            <invokerPackage>ca.bc.gov.nrs.scs.backend</invokerPackage>
                            <skipOverwrite>false</skipOverwrite>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useSpringBoot3>false</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <useOffsetDateTime>true</useOffsetDateTime>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ca.bc.gov.nrs.scs.backend.ScsApiApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
